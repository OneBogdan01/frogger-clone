[sub_resource type="GDScript" id="GDScript_bhunq"]
resource_name = "set_anim_frame"
script/source = "extends Node2D

func _ready() -> void:
	var anim= get_child(0) as AnimatedSprite2D
	var current_animation = anim.sprite_frames.get_animation_names()[0]
	var random_index=randi_range(0, anim.sprite_frames.get_frame_count(current_animation)-1)
	for child in get_children():
		child.frame = random_index
"

